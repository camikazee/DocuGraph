# Required. Generate two different values, at least 32 random bytes each.
# MEDIA_SECRET must remain stable across upgrades and restores.
JWT_SECRET=change-me-long-random
MEDIA_SECRET=change-me-different-long-random

# The only public application origin. Browser API calls use APP_URL/api/v1 and
# are forwarded to the backend over Portainer's private stack network.
APP_URL=https://docs.example.com
DOCUGRAPH_PORT=3002

# Optional application settings.
JWT_EXPIRES_IN=1d
SWAGGER_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DocuGraph <no-reply@docugraph.local>

# OAuth callbacks use the same public origin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://docs.example.com/api/v1/auth/github/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=https://docs.example.com/api/v1/auth/slack/callback

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10
