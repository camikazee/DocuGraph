# Public entry point. The browser uses APP_URL/api/v1 through the frontend.
DOCUGRAPH_PORT=3002
APP_URL=http://localhost:3002

# Public images. Pin DOCUGRAPH_TAG to a release in production.
DOCUGRAPH_REGISTRY=ghcr.io/camikazee
DOCUGRAPH_TAG=latest

# Generated automatically by ./scripts/install.sh. Keep MEDIA_SECRET stable.
JWT_SECRET=
MEDIA_SECRET=
JWT_EXPIRES_IN=1d

# Optional application settings.
SWAGGER_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DocuGraph <no-reply@docugraph.local>

# OAuth is optional. With the one-origin stack callbacks live below APP_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=

# Rate limiting.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10
